6:["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Global Teams"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Collaborated with engineers & sales teams across North America, Europe, and South Asia to implement automation solutions and share best practices."}]]}]
7:["$","div",null,{"className":"hpe-module__aUb4oG__jobSection","children":[["$","h2",null,{"className":"hpe-module__aUb4oG__jobTitle","children":"Technical Product Manager I"}],["$","p",null,{"className":"hpe-module__aUb4oG__date","children":"Sept 2023 - March 2025 (1 year 7 months)"}],["$","p",null,{"className":"hpe-module__aUb4oG__paragraph","children":"Drove a meaningful reduction in downtime and operational overhead through architecture and process improvements. Delivered customer‑facing dashboards and automation workflows that simplified complex networking API datasets. Improved stakeholder engagement and product adoption through presentations and iterative feedback cycles. Implemented networking AI integrations and created interactive, API-driven dashboards that surface network automation telemetry for varied audiences."}],["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Wide Impact"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Rebuilt the Developer Hub that receives ~650,000 page visits per year."}]]}],["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Cost Reduction"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Migrated Developer Hub data architecture to WordPress as a headless CMS, substantially reducing upkeep costs and improving site stability."}]]}],["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Presentation Volume"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Delivered regular presentations to 600+ HPE global employees on Automation and APIs & held partner ambassador presentations to over 100 partners."}]]}]]}]
8:["$","div",null,{"className":"hpe-module__aUb4oG__jobSection","children":[["$","h2",null,{"className":"hpe-module__aUb4oG__jobTitle","children":"UI/UX Engineer Intern"}],["$","p",null,{"className":"hpe-module__aUb4oG__date","children":"Summer 2022 (3 months)"}],["$","p",null,{"className":"hpe-module__aUb4oG__paragraph","children":["Summary:",["$","br",null,{}],"Designed and developed an end-to-end network automation framework website for HPE Aruba Networking’s Central product, acting as the sole contributor for the full stack deliverable and working directly with the data pipeline engineer.",["$","br",null,{}],["$","br",null,{}],"Led UI/UX design in Figma: created wireframes, interactive prototypes, and design refinements based on feedback from the UX team and stakeholders. Implemented the front end using Next.js (React), translating designs into responsive, accessible interfaces and reusable components. Built full-stack functionality with an AWS-backed API and services, integrating data pipelines to surface live telemetry and status information. Developed visualizations to display network health, automation run status, and metrics. Implemented network automation workflows and user flows for triggering, monitoring, and managing automated tasks. Owned testing, deployment, and iteration cycles; delivered the product from concept to production readiness as a single engineer contributor."]}],["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Project Presentation Audience"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Presented design concept to code completion of full stack website to 500+ HPE Employees"}]]}],["$","div",null,{"className":"hpe-module__aUb4oG__metricBox","children":[["$","h3",null,{"className":"hpe-module__aUb4oG__metricTitle","children":"Cross-Functional Exposure"}],["$","p",null,{"className":"hpe-module__aUb4oG__metricText","children":"Collaborated cross-functionally with UX, data engineering, and product teams to align requirements, prioritize features, and incorporate feedback."}]]}]]}]
